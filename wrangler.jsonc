{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saigaiban",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "OPENNAVI_ORIGIN": "https://opennavi.org",
    "SITE_ORIGIN": "https://saigaiban.com",
    "GA4_MEASUREMENT_ID": "G-4KQPS1LRHV",
    "PUBLIC_READ_CACHE": "off",
    "PUBLIC_POSTING_MODE": "off"
  },
  "routes": [
    { "pattern": "saigaiban.com", "custom_domain": true },
    { "pattern": "www.saigaiban.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saigaiban",
      "database_id": "0046f5ce-1566-4da6-91a5-406a5c9c7118",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 * * * *"] }
}
